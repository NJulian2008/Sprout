# ─── Database ────────────────────────────────────────────────────────────────
# SQLite path (relative to project root). Defaults to sqlite:///app.db
DATABASE_URL=sqlite:///app.db

# ─── Session ──────────────────────────────────────────────────────────────────
# Secret key used to sign session cookies. Change this before any deployment.
SESSION_SECRET=change-me-in-production

# ─── LLM Mode ─────────────────────────────────────────────────────────────────
# Controls how AI calls are handled:
#   live    — hit the real GitHub Copilot/OpenAI endpoint (requires COPILOT_TOKEN)
#   cached  — serve responses from the LLMCache table; raise LLMUnavailable on miss
#   off     — disable AI entirely; fall back to heuristic matching throughout
LLM_MODE=off

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Enables the /demo panel and role-switching UI.
#   normal  — demo panel available, seed data loaded
#   off     — demo panel hidden (for real deployments)
DEMO_MODE=normal

# ─── GitHub Copilot / OpenAI-compatible endpoint ──────────────────────────────
# Bearer token for the LLM endpoint. Only required when LLM_MODE=live.
COPILOT_TOKEN=
